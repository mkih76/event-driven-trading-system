ANTHROPIC_API_KEY=your_claude_api_key_here

# 管理端点密钥（用于图谱热重载等管理操作）
# ADMIN_KEY=your_admin_key

# 知识图谱配置路径
# GRAPH_CONFIG_PATH=app/services/causal_reasoning/graph_data.yml
# GRAPH_DATA_PATH=app/services/causal_reasoning/graph_data.json

# 相似度阈值配置
# SEMANTIC_SIMILARITY_THRESHOLD=0.5  # 语义相似度阈值
# EVENT_MATCH_SIMILARITY_THRESHOLD=0.6  # 事件匹配阈值
# MIN_CONFIDENCE_THRESHOLD=0.5  # 最小置信度阈值
